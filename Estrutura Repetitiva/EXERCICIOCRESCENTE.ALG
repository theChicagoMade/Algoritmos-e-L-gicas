Algoritmo "EXERCICIOCRESCENTE"

Var

X, Y : inteiro

Inicio

escreval("Digite dois números: ")
leia(X)
leia(Y)

enquanto X <> Y faca
         se X < Y entao
         escreval("CRESCENTE")
         senao
         escreval("DECRESCENTE")
         fimse
         
escreval("Digite outros dois números: ")
leia(X)
leia(Y)


fimenquanto
Fimalgoritmo