Algoritmo "EXERCICIOTROCOVERIFICADO"

Var

preco, quantidade, dinheiro : inteiro

Inicio
  escreva("Preço unitário do produto: ")
  leia (preco)
  escreval("Quantidade comprada: ")
  leia (quantidade)
  escreval("Dinheiro recebido: ")
  leia (dinheiro)

  Troco <- preco * quantidade - troco
  se troco => 0 entao
     valorPago <- valorPago + 2 * (minutos-100)
  fimse
  
  escreval("Valor a pagar: R$ ", valorPago:4:2)



Fimalgoritmo